{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Diagnóstico e operações editoriais específicas na janela principal, sem acesso genérico a arquivos ou SQL.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-assisted-list",
    "allow-assisted-prepare",
    "allow-assisted-confirm",
    "allow-assisted-reconcile",
    "allow-assisted-history",
    "allow-assisted-caption",
    "allow-assisted-folder-open",
    "allow-assisted-business-open",
    "allow-assisted-choose-root",
    "allow-calendar-list",
    "allow-calendar-available",
    "allow-schedule-save",
    "allow-schedule-cancel",
    "allow-schedule-settings-save",
    "allow-planning-dashboard",
    "allow-schedule-history",
    "allow-review-list",
    "allow-review-get",
    "allow-review-decide",
    "allow-review-history",
    "allow-foundation-status",
    "allow-publication-list",
    "allow-publication-get",
    "allow-publication-save",
    "allow-publication-duplicate",
    "allow-publication-delete",
    "allow-editorial-counts",
    "allow-media-select",
    "allow-media-discard",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "allow-trello-status",
    "allow-trello-connect",
    "allow-trello-test",
    "allow-trello-disconnect",
    "allow-trello-authorization-url",
    "allow-trello-preview",
